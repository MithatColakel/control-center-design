  "meta": {
    "source": "design",
    "repo": "VPNProject (branch design-system)",
    "app": "apps/vpn-control-center",
    "stack": "React + shadcn/ui (Radix) + Tailwind 3 + Recharts + lucide-react",
    "note": "One neutral look for both brands. Name, logo and favicon come from env (APP_NAME, APP_ICON). A small brand layer (primary, primary-hover, primary-foreground, ring, sidebar-accent) is kept on a private page; all other tokens are the same for both brands. Values are CSS px. handoff/index.css gives the shadcn HSL values.",
    "chartPalette": "dataviz reference palette, validated with validate_palette.js on card #ffffff (light) and #111113 (dark): all checks pass; light slots 3, 4, 5 are below 3:1, so charts that use them show direct labels or a table view."
  },
